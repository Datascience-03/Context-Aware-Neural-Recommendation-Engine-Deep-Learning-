import tensorflow as tf

def build_training_pipeline(dataset: tf.data.Dataset, batch_size: int = 128):
    """
    Takes the dataset from your pipeline and prepares batches.
    Format expected: {"query_inputs": ..., "candidate_inputs": ...}
    """
    return (
        dataset
        .shuffle(buffer_size=10000)
        .batch(batch_size, drop_remainder=True) # drop_remainder ensures consistent batch sizes for in-batch negatives
        .prefetch(tf.data.AUTOTUNE)
    )

